{
  "name": "accounting-calendar",
  "version": "1.0.2",
  "description": "Accounting calendar view of your daily notes",
  "author": "susiel007",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "lint": "svelte-check && eslint . --ext .ts",
    "build": "npm run lint && rollup -c",
    "test": "jest --passWithNoTests",
    "test:watch": "yarn test -- --watch"
  },
  "dependencies": {
    "obsidian": "1.7.2",
    "obsidian-calendar-ui": "file:src/obsidian-calendar-ui",
    "obsidian-daily-notes-interface": "0.9.0",
    "svelte": "3.35.0",
    "tslib": "2.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/jest": "26.0.22",
    "@types/moment": "2.13.0",
    "@typescript-eslint/eslint-plugin": "4.20.0",
    "@typescript-eslint/parser": "4.20.0",
    "eslint": "7.23.0",
    "jest": "26.6.3",
    "moment": "2.29.1",
    "rollup": "^4.0.0",
    "rollup-plugin-svelte": "^7.2.0",
    "svelte-check": "1.3.0",
    "svelte-jester": "1.3.2",
    "svelte-preprocess": "^5.1.4",
    "ts-jest": "26.5.4",
    "typescript": "^5.0.0"
  },
  "jest": {
    "moduleNameMapper": {
      "src/(.*)": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.svelte$": [
        "svelte-jester",
        {
          "preprocess": true
        }
      ],
      "^.+\\.ts$": "ts-jest"
    },
    "moduleFileExtensions": [
      "js",
      "ts",
      "svelte"
    ]
  }
}
